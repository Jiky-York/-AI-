# Mock 模式（演示用，无需真实 API Key）
MOCK_MODE=true

# 被评模型 API Key（Mock 模式下无需填写；真实评测时填入）
QWEN_API_KEY=your_qwen_api_key
KIMI_API_KEY=your_kimi_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key

# 评委模型（文心一言，千帆 v2 兼容接口）
# 只需一个 API Key，另需应用身份 ID（appid，形如 app-XXXX）
ERNIE_API_KEY=your_ernie_api_key
ERNIE_APP_ID=your_ernie_app_id
